# Root .env - read by docker compose for the local PostgreSQL container.
# Copy to .env and adjust if needed. App-specific settings live in
# apps/api/.env.example and apps/web/.env.example.

# Database user created in the container
POSTGRES_USER=tracker
# Local-only password for the container (never reuse a real password here)
POSTGRES_PASSWORD=tracker
# Database created on first start
POSTGRES_DB=work_tracker
# Host port mapped to the container's 5432. 5433 avoids clashing with a locally
# installed PostgreSQL, which usually owns 5432.
POSTGRES_PORT=5433
