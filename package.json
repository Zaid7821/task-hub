{
  "name": "aionos-work-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "AIonOS Work Tracker — internal project and task tracking",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @aionos/shared build && pnpm --parallel --filter @aionos/shared --filter @aionos/api --filter @aionos/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @aionos/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @aionos/api db:migrate",
    "db:seed": "pnpm --filter @aionos/api db:seed",
    "db:studio": "pnpm --filter @aionos/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
