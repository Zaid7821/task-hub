# Web environment - copy to apps/web/.env. Values are validated at startup
# (see src/env.ts). Everything prefixed VITE_ is bundled into the browser, so
# never put secrets here.

# Base URL of the API, including the version prefix
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Local development switches ----------------------------------------------
# Both are ignored outside `vite dev`, and `vite build` fails if either is on.

# true = intercept all API calls in the browser with MSW mock handlers (src/mocks)
VITE_USE_MOCKS=true

# dev   = pick a seed user on the login page; requests carry X-Dev-User-Email
#         (works against mocks, or the real API with AUTH_DEV_BYPASS=true)
# entra = real Microsoft Entra ID login via MSAL (requires the VITE_ENTRA_* values)
VITE_AUTH_MODE=dev

# --- Microsoft Entra ID (required when VITE_AUTH_MODE=entra) -------------------
# Application (client) ID of the *SPA* app registration
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Directory (tenant) ID of the AIonOS Entra tenant
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Must exactly match a SPA redirect URI registered on the SPA app registration
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
# Delegated scope exposed by the API app registration
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
