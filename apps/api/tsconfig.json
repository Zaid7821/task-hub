{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    // DTO and entity classes are populated by class-transformer/Nest, not constructors.
    "strictPropertyInitialization": false,
    "removeComments": true,
    "declaration": false,
    "rootDir": ".",
    "outDir": "./dist",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "test", "prisma", "*.ts"]
}
