# API environment - copy to apps/api/.env. Every variable is validated at startup
# (see src/config/env.validation.ts); the API refuses to start if one is invalid.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=3000

# PostgreSQL connection string. Must match the values in the root .env used by docker compose.
DATABASE_URL=postgresql://tracker:tracker@localhost:5433/work_tracker?schema=public

# Comma-separated list of browser origins allowed to call the API (the web app URL)
CORS_ORIGINS=http://localhost:5173

# Serve Swagger UI at /api/docs (set to false in production if not needed)
SWAGGER_ENABLED=true

# --- Microsoft Entra ID -------------------------------------------------------
# Directory (tenant) ID of the AIonOS Entra tenant
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID of the *API* app registration
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Expected "aud" claim of access tokens. For v2 tokens this is the API's client ID;
# if your tokens carry the Application ID URI instead, use e.g. api://<api-client-id>
ENTRA_API_AUDIENCE=00000000-0000-0000-0000-000000000000
# Entra login host. Leave as is unless the tenant is in a sovereign cloud.
ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com

# --- Microsoft Graph directory sync -------------------------------------------
# Imports employees, departments and managers from Entra ID (see README, "Graph sync").
# Uses the API app registration above with the application permission User.Read.All.
GRAPH_SYNC_ENABLED=false
# Client secret of the API app registration. Required when GRAPH_SYNC_ENABLED=true.
GRAPH_CLIENT_SECRET=
# Graph endpoint. Leave as is unless the tenant is in a sovereign cloud.
GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
# Hours between automatic syncs (0 = only when an admin presses "Sync now").
GRAPH_SYNC_INTERVAL_HOURS=24

# --- Local development only ---------------------------------------------------
# When true, requests can authenticate with an "X-Dev-User-Email: <email>" header
# for an existing active user instead of an Entra token. Startup fails if this is
# true while NODE_ENV=production.
AUTH_DEV_BYPASS=false
